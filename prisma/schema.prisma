generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model users {
  id       Int    @id @default(autoincrement())
  email    String @unique
  username String @unique
  password String

  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  articles  articles[]
}

model articles {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  body        String
  tags        tags[]

  authorId Int
  author   users @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model tags {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  articles articles[]
}
