generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
  moduleFormat    = "cjs"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  username  String    @unique
  password  String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  articles  Article[]
  comments  Comment[]

  @@index([createdAt])
  @@map("users")
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  body        String
  authorId    Int
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        Tag[]     @relation("articlesTotags")
  comments    Comment[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([authorId])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("articles")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  articles  Article[] @relation("articlesTotags")

  @@map("tags")
}

model Comment {
  id        Int      @id @default(autoincrement())
  comment   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([authorId])
  @@index([createdAt])
  @@index([articleId, createdAt])
  @@map("comments")
}

view ArticleDetailView {
  id          Int
  title       String
  description String
  body        String
  username    String
  tags        Json?    @db.Json
  createdAt   DateTime @db.Timestamptz(3)
  updatedAt   DateTime @db.Timestamptz(3)

  @@map("article_detail_view")
}
